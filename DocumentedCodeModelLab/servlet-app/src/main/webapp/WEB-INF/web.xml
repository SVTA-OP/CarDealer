<?xml version="1.0" encoding="UTF-8"?>
<!-- =====================================================================
  web.xml = the DEPLOYMENT DESCRIPTOR. It tells Tomcat which servlets exist
  and which URL goes to which servlet.
  There are 2 ways to register a servlet:
     (A) here in web.xml          -> used for HelloServlet
     (B) @WebServlet annotation   -> used for StudentServlet
====================================================================== -->
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

  <display-name>Servlet Demo</display-name>

  <!-- Step 1: give the servlet class a name -->
  <servlet>
    <servlet-name>HelloServlet</servlet-name>
    <servlet-class>com.example.servlet.HelloServlet</servlet-class>
  </servlet>

  <!-- Step 2: map a URL to that name  ->  http://localhost:8080/servletdemo/hello -->
  <servlet-mapping>
    <servlet-name>HelloServlet</servlet-name>
    <url-pattern>/hello</url-pattern>
  </servlet-mapping>

  <!-- The page shown when you open http://localhost:8080/servletdemo/ -->
  <welcome-file-list>
    <welcome-file>index.html</welcome-file>
  </welcome-file-list>
</web-app>
